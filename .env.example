# .env.example — commit this file. DO NOT commit .env.local with real secrets.
# Copy to .env.local and fill in values before running.

# ── Server ──────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
HOST=0.0.0.0
PORT=8443
LOG_LEVEL=info               # debug | info | warn | error
SERVER_URL=http://localhost:8443

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/im.db

# ── Auth tokens ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS
TOKEN_EXPIRY_SECONDS=900     # 15 minutes

# ── TOTP ─────────────────────────────────────────────────────────────────────
# Used to encrypt TOTP secrets at rest in the DB.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOTP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS

# ── TLS (for production — use real certs) ────────────────────────────────────
# Local dev path. Docker Compose overrides this to /app/certs/ via volume mount.
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5       # max attempts per window
RATE_LIMIT_LOGIN_WINDOW=300  # seconds (5 minutes)
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=3600

# ── Message retention ─────────────────────────────────────────────────────────
MAX_MESSAGE_AGE_DAYS=30      # delete undelivered messages older than this
TTL_CLEANUP_INTERVAL=300     # run TTL cleanup every N seconds
