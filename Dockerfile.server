# Dockerfile.server
# Multi-stage build. Non-root user. Pinned base image. No secrets in image.
# Self-signed TLS cert is auto-generated at container startup via entrypoint.

# ── Stage 1: dependency resolution ──────────────────────────────────────────
FROM python:3.12.9-slim AS deps

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.5.21 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-editable

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.12.9-slim AS runtime

# openssl needed for auto cert generation at startup
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup -s /sbin/nologin appuser

WORKDIR /app

# Copy venv from deps stage
COPY --from=deps /app/.venv /app/.venv

# Copy application source
COPY server/  ./server/
COPY shared/  ./shared/

# Copy entrypoint BEFORE the chmod RUN step
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Set permissions — all in one layer
RUN mkdir -p /app/data /app/certs \
    && chown -R appuser:appgroup /app/data /app/certs /app/server /app/shared \
    && chmod -R a+rX /app/server /app/shared \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

USER appuser

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TLS_CERT_FILE=/app/certs/server.crt
ENV TLS_KEY_FILE=/app/certs/server.key
ENV APP_ENV=development

EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "\
import urllib.request, ssl; \
ctx = ssl.create_default_context(); \
ctx.check_hostname = False; \
ctx.verify_mode = ssl.CERT_NONE; \
urllib.request.urlopen('https://localhost:8443/health', context=ctx)" \
    || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["python", "-m", "server.main"]