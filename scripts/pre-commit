#!/usr/bin/env bash
# Pre-commit hook: clean mechanical whitespace first, then run Python checks.
# Skip with: git commit --no-verify

set -euo pipefail

# Collect staged text files where trailing whitespace is always accidental.
mapfile -t TEXT_FILES < <(
    git diff --cached --name-only --diff-filter=ACMR -- \
        '*.py' '*.md' '*.txt' '*.toml' '*.yml' '*.yaml' '*.sh'
)

if [[ ${#TEXT_FILES[@]} -gt 0 ]]; then
    echo "clean trailing whitespace …"
    perl -pi -e 's/[ \t]+$//' "${TEXT_FILES[@]}"
    git add -- "${TEXT_FILES[@]}"
fi

# Collect staged .py files (added, copied, modified, renamed)
mapfile -t PY_FILES < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [[ ${#PY_FILES[@]} -eq 0 ]]; then
    exit 0   # nothing Python-related staged
fi

echo "ruff check …"
uv run ruff check "${PY_FILES[@]}"
echo "ruff format --check …"
uv run ruff format --check "${PY_FILES[@]}"
echo "mypy …"
./.venv/bin/mypy client server
echo "check silent broad excepts …"
uv run python scripts/check_silent_excepts.py
echo "check stale security claims …"
uv run python scripts/check_stale_security_claims.py
echo "pre-commit checks passed"
