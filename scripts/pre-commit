#!/usr/bin/env bash
# Pre-commit hook: run ruff lint + format check on staged Python files.
# Skip with: git commit --no-verify

set -euo pipefail

# Collect staged .py files (added, copied, modified, renamed)
mapfile -t PY_FILES < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [[ ${#PY_FILES[@]} -eq 0 ]]; then
    exit 0   # nothing Python-related staged
fi

echo "ruff check …"
uv run ruff check "${PY_FILES[@]}"
echo "ruff format --check …"
uv run ruff format --check "${PY_FILES[@]}"
echo "pre-commit checks passed"
